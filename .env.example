# Safe defaults: analysis only. Never commit real credentials.
EXECUTION_MODE=ANALYSIS_ONLY
EXECUTION_ENABLED=false
EMERGENCY_STOP=false

# Broker/MT5 runtime secrets — inject through the deployment secret store.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_TERMINAL_PATH=

# Market-data provider configuration.
MARKET_DATA_PROVIDER=mt5
MARKET_DATA_API_KEY=

# Risk controls are configuration, not strategy constants.
MAX_RISK_PER_TRADE=0.005
MAX_DAILY_LOSS=0.02
MAX_OPEN_POSITIONS=3
MAX_TRADES_PER_DAY=5
MAX_LOT_SIZE=1.0
MAX_SPREAD_POINTS=30
MAX_SL_DISTANCE_POINTS=5000

ALLOWED_PAIRS=EURUSD,GBPUSD,USDJPY,USDCHF,USDCAD,AUDUSD,NZDUSD,EURJPY,GBPJPY
ALLOWED_SESSIONS=ASIA,LONDON,NEW_YORK,OVERLAP
